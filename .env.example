# .env.example
# Configuración del entorno
PROJECT_NAME="MultiBurV1 API"
ENVIRONMENT="development"
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:5173"]
# En produccion agregar el dominio de Vercel:
# CORS_ORIGINS=["https://tu-frontend.vercel.app"]

# Base de datos
# Local por defecto:
DATABASE_URL=sqlite:///./test.db

# Produccion Supabase/PostgreSQL:
# DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:PUERTO/postgres?sslmode=require

# DATABASE_URL es la variable que usa el backend para elegir la base de datos.

# Seguridad
# Generar un SECRET_KEY seguro usando: openssl rand -hex 32
SECRET_KEY="SUSTITUIR_POR_UN_SECRETO_GENERADO_MUY_SEGURO_Y_LARGO"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 horas
